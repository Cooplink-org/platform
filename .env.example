# Django settings
DEBUG=True
SECRET_KEY=change-me-in-production
DJANGO_ENV=dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cooplink

# Celery and Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0?ssl_cert_reqs=none
CELERY_RESULT_BACKEND=redis://localhost:6379/0?ssl_cert_reqs=none

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False

# GitHub OAuth App credentials
# Register at https://github.com/settings/developers → "OAuth Apps" → "New OAuth App"
#   Homepage URL:               http://localhost:8000
#   Authorization callback URL: http://localhost:8000/api/auth/github/callback/
#
# GitHub Apps only support one callback URL per app. Both the login flow and the
# seller connect-repos flow share this URL — the backend distinguishes them via
# the `state` param that GitHub round-trips back unchanged.
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback/

# Frontend URL — OAuth callback redirects the browser here with JWT tokens
FRONTEND_URL=http://localhost:3000

# Fernet key — used to encrypt GitHub access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# MirPay.uz Payment Gateway credentials
# Register at https://mirpay.uz/dashboard to obtain a kassa id and api key
MIRPAY_KASSA_ID=your_mirpay_kassaid_here
MIRPAY_API_KEY=your_mirpay_api_key_here

# Telegram API Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Telegram Bot Webhook Configuration
# Bot username (without @) — used to build the deep link shown to users
TELEGRAM_BOT_USERNAME=cooplink_bot
# A random, unguessable string used in the webhook URL path.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here
# Optional: if you set this via setWebhook's secret_token param, Telegram
# will send it as X-Telegram-Bot-Api-Secret-Token header on every update.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_API_SECRET_TOKEN=
