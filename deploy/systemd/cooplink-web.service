[Unit]
Description=Cooplink Django app (gunicorn)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
Type=notify
User=cooplink
Group=cooplink
WorkingDirectory=/opt/cooplink
EnvironmentFile=/opt/cooplink/.env
ExecStart=/opt/cooplink/.venv/bin/gunicorn cooplink.wsgi:application \
          --bind 127.0.0.1:8000 \
          --workers 2 \
          --timeout 120 \
          --access-logfile - \
          --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
