# Production environment template for Cooplink backend.
# Copy to /opt/cooplink/.env and fill in the values. Never commit this file.

# --- Django ---
DEBUG=False
DJANGO_ENV=prod
SECRET_KEY=__CHANGE_ME_SECRET_KEY__
ALLOWED_HOSTS=YOUR_DOMAIN
# App sits behind nginx which terminates TLS, so let nginx handle the redirect.
SECURE_SSL_REDIRECT=False

# --- Database (local PostgreSQL) ---
DATABASE_URL=postgres://cooplink:__DB_PASSWORD__@localhost:5432/cooplink

# --- Celery / Redis (local) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
CORS_ALLOW_ALL_ORIGINS=False

# --- Frontend / GitHub OAuth ---
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
GITHUB_CALLBACK_URL=https://YOUR_DOMAIN/api/auth/github/callback/
GITHUB_CLIENT_ID=__CHANGE_ME__
GITHUB_CLIENT_SECRET=__CHANGE_ME__

# --- Encryption (GitHub tokens, payout cards) ---
FERNET_KEY=__CHANGE_ME_FERNET__

# --- Payments (optional; can also be set in Django admin) ---
MIRPAY_KASSA_ID=
MIRPAY_API_KEY=
MIRPAY_CALLBACK_SECRET=
INPAY_MERCHANT_ID=
INPAY_MERCHANT_TOKEN=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_USERNAME=cooplink_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_API_SECRET_TOKEN=

# --- AI reviewer (optional) ---
ALIBABA_MODEL_STUDIO_API_KEY=
